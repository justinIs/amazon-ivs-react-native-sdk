# Config for scripts/ivs — copy to scripts/ivs.env (gitignored) and edit.
#
# The script sources this file; command-line flags override these values.
# Comment a line out to fall back to your ambient shell environment instead
# (e.g. leave AWS_PROFILE unset here to use whatever your shell already exports).

# --- AWS auth / region ---
AWS_PROFILE=default
AWS_REGION=us-east-1

# --- Default stage for `ivs token` (override with --stage-arn) ---
# Create one with:  ./scripts/ivs create-stage my-stage
#IVS_STAGE_ARN=arn:aws:ivs:us-east-1:123456789012:stage/abcdEXAMPLE

# --- Token defaults for `ivs token` ---
IVS_TOKEN_USER_ID=demo-user
IVS_TOKEN_DURATION=720                  # minutes (10–20160; default 720 = 12h)
IVS_TOKEN_CAPABILITIES=PUBLISH,SUBSCRIBE

# `username` is attached as a token attribute, visible to other participants.
IVS_TOKEN_USERNAME=Demo User

# Extra attributes as comma-separated key=value pairs (no commas within values).
#IVS_TOKEN_ATTRIBUTES=role=host,team=blue
