{
  "name": "amazon-ivs-react-native-sdk",
  "version": "0.2.0",
  "description": "React Native SDK for Amazon IVS Real-Time (Stages) — local camera preview PoC",
  "workspaces": [
    "example"
  ],
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "amazon-ivs-react-native-sdk-source": "./src/index.tsx",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "android",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "example": "pnpm --filter amazon-ivs-react-native-sdk-example",
    "clean": "node -e \"const fs = require('node:fs'); for (const p of ['android/build', 'example/android/build', 'example/android/app/build', 'lib']) fs.rmSync(p, { recursive: true, force: true });\"",
    "prepare": "bob build",
    "typecheck": "tsc",
    "lint": "eslint \"**/*.{js,ts,tsx}\""
  },
  "keywords": [
    "react-native",
    "android",
    "amazon-ivs",
    "webrtc",
    "video"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/justinIs/amazon-ivs-react-native-sdk.git"
  },
  "author": "Justin W <justin.graham49@gmail.com> (https://github.com/agilityfeat)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/justinIs/amazon-ivs-react-native-sdk/issues"
  },
  "homepage": "https://github.com/justinIs/amazon-ivs-react-native-sdk#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@babel/runtime": "^7.25.0"
  },
  "devDependencies": {
    "@eslint/compat": "2.1.0",
    "@eslint/eslintrc": "3.3.5",
    "@eslint/js": "9.39.4",
    "@react-native/babel-preset": "0.85.3",
    "@react-native/eslint-config": "0.85.3",
    "@types/react": "19.2.17",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-ft-flow": "3.0.11",
    "eslint-plugin-prettier": "5.5.6",
    "prettier": "3.9.4",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-builder-bob": "0.43.0",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "engines": {
    "node": ">= 22.11.0"
  },
  "packageManager": "pnpm@11.10.0+sha512.0b7f8b98060031904c017e3a41eb187a16d40eeb829b95c4f8cb03681761fc4ab53dd219115b9b447f4dce1a05a214764461e7d3703392a9f32f9511ce8c86c8",
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "codegenConfig": {
    "name": "IvsRealtimeSpec",
    "type": "all",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.ivsrealtime"
    }
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  }
}
