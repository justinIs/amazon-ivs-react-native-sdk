{
  "name": "amazon-ivs-react-native-sdk",
  "version": "0.1.0",
  "description": "React Native SDK for Amazon IVS Real-Time (Stages)",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "amazon-ivs-react-native-sdk-source": "./src/index.tsx",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "vendor",
    "*.podspec",
    "react-native.config.js",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "example": "yarn workspace amazon-ivs-react-native-sdk-example",
    "prepare": "bob build",
    "clean": "del-cli lib android/build ios/build example/android/build example/android/app/build example/ios/build",
    "typecheck": "tsc",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "test": "jest",
    "docs:api": "typedoc",
    "release": "changeset publish"
  },
  "keywords": [
    "react-native",
    "ios",
    "android",
    "amazon-ivs",
    "ivs",
    "real-time",
    "stages"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WebRTCventures/amazon-ivs-react-native-sdk.git"
  },
  "author": "WebRTC Ventures",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/WebRTCventures/amazon-ivs-react-native-sdk/issues"
  },
  "homepage": "https://github.com/WebRTCventures/amazon-ivs-react-native-sdk#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@babel/runtime": "^7.25.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.0",
    "@eslint/compat": "^2.1.0",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@react-native/babel-preset": "0.85.3",
    "@react-native/eslint-config": "0.85.3",
    "@react-native/jest-preset": "0.85.3",
    "@testing-library/react-native": "^13.2.0",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.2.0",
    "del-cli": "^7.0.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-ft-flow": "^3.0.11",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^29.7.0",
    "prettier": "^3.8.3",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-builder-bob": "^0.43.0",
    "react-test-renderer": "19.2.3",
    "turbo": "^2.9.16",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.12.0",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "react": ">=18.2.0",
    "react-native": ">=0.81.0"
  },
  "workspaces": [
    "example"
  ],
  "packageManager": "yarn@4.11.0",
  "engines": {
    "node": ">= 22.11.0"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "codegenConfig": {
    "name": "AmazonIvsRealTimeSpec",
    "type": "all",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.amazonivsrealtime"
    },
    "ios": {
      "components": {
        "IvsLocalPreviewView": {
          "className": "IvsLocalPreviewView"
        },
        "IvsParticipantVideoView": {
          "className": "IvsParticipantVideoView"
        }
      }
    }
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "create-react-native-library": {
    "type": "fabric-view",
    "languages": "kotlin-objc",
    "tools": [
      "eslint"
    ],
    "version": "0.63.0"
  }
}
